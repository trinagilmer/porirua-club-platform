<!-- 🧭 LEFT COLUMN — Sidebar Partial -->
<aside class="function-sidebar" aria-label="Function details">
  <div class="sidebar-mobile-header">
    <span>Function details</span>
    <button type="button" class="sidebar-close" aria-label="Close details">&times;</button>
  </div>
  <div class="sidebar-scroll-container"> <!-- NEW WRAPPER -->

    <!-- 🧩 FUNCTION META -->
    <div class="function-meta">
      <h2 contenteditable="true" class="editable" data-field="event_name" data-id="<%= fn.id_uuid %>">
        <%= fn.event_name %>
      </h2>
      <select class="form-select status-select editable" data-field="status" data-id="<%= fn.id_uuid %>">
        <option value="lead" <%= fn.status==='lead'?'selected':'' %>>Lead</option>
        <option value="confirmed" <%= fn.status==='confirmed'?'selected':'' %>>Confirmed</option>
        <option value="cancelled" <%= fn.status==='cancelled'?'selected':'' %>>Cancelled</option>
      </select>
    </div>

    <section class="sidebar-block function-nav-block">
      <h4>Function</h4>
      <nav class="function-side-nav" aria-label="Function navigation">
        <a href="/functions/<%= fn.id_uuid %>/edit" class="<%= ['overview', 'edit'].includes(activeTab || 'edit') ? 'active' : '' %>">
          <i class="bi bi-pencil"></i> Function
        </a>
        <a href="/functions/<%= fn.id_uuid %>/quote" class="<%= activeTab === 'quote' ? 'active' : '' %>">
          <i class="bi bi-receipt"></i> Quote
        </a>
        <a href="/functions/<%= fn.id_uuid %>/tasks" class="<%= activeTab === 'tasks' ? 'active' : '' %>">
          <i class="bi bi-check2-square"></i> Tasks
        </a>
        <a href="/functions/<%= fn.id_uuid %>/notes" class="<%= activeTab === 'notes' ? 'active' : '' %>">
          <i class="bi bi-journal-text"></i> Notes
        </a>
        <a href="/functions/<%= fn.id_uuid %>/communications" class="<%= activeTab === 'communications' ? 'active' : '' %>">
          <i class="bi bi-envelope"></i> Communications
        </a>
      </nav>

      <div class="function-quick-actions">
        <button type="button" class="btn btn-sm btn-primary w-100" data-open-add-contact>
          <i class="bi bi-person-plus me-1"></i> Add contact
        </button>
      </div>
    </section>

    <!-- 👥 CONTACT BLOCK -->
    <section class="function-contact-block sidebar-block">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h4>Contacts</h4>
        <button type="button" class="btn btn-sm btn-outline-primary" data-open-add-contact>+ Add</button>
      </div>

      <% if (linkedContacts.length > 0) { %>
        <ul class="contact-list">
          <% linkedContacts.forEach(c => { %>
            <li class="contact-card">
              <div class="contact-info">
                <strong><%= c.name %></strong>
                <% if (c.is_primary) { %>
                  <span class="badge bg-success ms-1">Primary</span>
                <% } %><br>
                <small><%= c.email || 'No email' %></small><br>
                <small><%= c.phone || '' %></small>
              </div>

              <!-- ⋮ BURGER MENU -->
              <div class="menu-container">
                <button class="menu-btn fn-menu-btn" data-id="<%= c.id %>">⋮</button>
                <div id="menu-<%= c.id %>" class="menu-dropdown fn-menu-dropdown hidden">
                  <button class="edit-btn" data-id="<%= c.id %>">Edit</button>
                  <% if (!c.is_primary) { %>
                    <button class="primary-btn" data-id="<%= c.id %>">Make Primary</button>
                  <% } %>
                  <button class="remove-btn" data-id="<%= c.id %>">Remove</button>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-muted">No contacts linked</p>
      <% } %>
    </section>
  </div> <!-- /sidebar-scroll-container -->
</aside>
<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

