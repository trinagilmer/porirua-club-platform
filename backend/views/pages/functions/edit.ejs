      <div class="row g-2">
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetFacilities" checked><span class="form-check-label">Show room facilities</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetCatering" checked><span class="form-check-label">Show food service times</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetDietary" checked><span class="form-check-label">Show dietary requirements</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetQuantities" checked><span class="form-check-label">Show quantities</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetCosts"><span class="form-check-label">Show cost details</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetPrices"><span class="form-check-label">Show sale prices</span></label></div>
        <div class="col-sm-6"><label class="form-check"><input class="form-check-input" type="checkbox" id="runSheetInvoice"><span class="form-check-label">Show payment / invoice details</span></label></div>
      </div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button><button type="button" class="btn btn-primary" id="editRunSheetPreviewBtn">Preview / print</button></div>
  </div></div>
</div>

