<!-- 🛠️ pages/functions/edit.ejs -->
<% locals.layout = 'layouts/main'; %>
<%
  const savedCateringSchedule = Array.isArray(fn.catering_schedule) ? fn.catering_schedule : [];
  const cateringRows = savedCateringSchedule.length ? savedCateringSchedule : [{ time: '', label: '', description: '' }];
%>
<style>
  .function-form-card,
  .function-form-card .form-label,
  .function-form-card .form-check-label,
  .function-form-card .form-control,
  .function-form-card .form-select,
  .function-form-card .text-muted,
  .function-form-card .small,
  .function-form-card table { font-size: 1rem !important; }
  .catering-service-row { display: grid; grid-template-columns: 110px minmax(140px, 0.8fr) minmax(220px, 1.6fr) 38px; gap: 8px; align-items: end; }
  @media (max-width: 767.98px) { .catering-service-row { grid-template-columns: 1fr; } }
</style>
    <!-- 🔹 Body -->
    <div class="function-body py-4 px-4">

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p class="text-muted small mb-0">Update the booking, room setup and pricing from one screen.</p>
        <div class="d-flex flex-wrap gap-2">
        <a href="/functions/<%= fn.id_uuid %>/tasks" class="btn btn-sm btn-outline-secondary"><i class="bi bi-check2-square me-1"></i>Tasks</a>
        <a href="/functions/<%= fn.id_uuid %>/communications" class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope me-1"></i>Communications</a>
        <% if (quoteTotals && quoteTotals.id) { %><a href="/functions/<%= fn.id_uuid %>/proposal/preview" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>Proposal</a><% } %>
        <form method="POST" action="/functions/<%= fn.id_uuid %>/clone" class="d-inline" onsubmit="return confirm('Create a copy of this function?');"><button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-files me-1"></i>Clone</button></form>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editRunSheetModal">
          <i class="bi bi-clipboard-check me-1"></i>Run sheet
        </button>
        <a href="/functions" class="btn btn-outline-secondary">Back</a>
        <button type="submit" form="editFunctionForm" class="btn btn-primary">Save Changes</button>
        </div>
      </div>

      <!-- 🧾 Edit Form -->
      <form id="editFunctionForm" method="POST" action="/functions/<%= fn.id_uuid %>/edit" class="d-flex flex-column gap-2 function-form-card">
        <!-- 🔹 ESSENTIALS SECTION -->
        <section class="border rounded bg-white p-3 shadow-sm function-required-info">
          <p class="quote-kicker mb-2">Essential details</p>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Event Name *</label>
              <input type="text" name="event_name" class="form-control" value="<%= fn.event_name || '' %>" required />
            </div>

            <div class="col-md-3">
              <label class="form-label fw-semibold">Date</label>
              <input type="date" id="fn_event_date" name="event_date" class="form-control"
                     value="<%= fn.event_date ? fn.event_date.toISOString().slice(0,10) : '' %>" />
            </div>

            <div class="col-md-3">
              <label class="form-label">End date</label>
              <input type="date" id="fn_end_date" name="end_date" class="form-control"
                     value="<%= fn.end_date ? fn.end_date.toISOString().slice(0,10) : '' %>" />
            </div>

            <div class="col-md-3">
              <label class="form-label">Start Time</label>
              <input type="time" name="start_time" class="form-control" value="<%= fn.start_time || '' %>" />
            </div>

            <div class="col-md-3">
              <label class="form-label">End Time</label>
              <input type="time" name="end_time" class="form-control" value="<%= fn.end_time || '' %>" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Room / Space</label>
              <select name="room_id" class="form-select">
                <option value="">Select a room</option>
                <% rooms.forEach(r => { %>
                  <option value="<%= r.id %>" <%= fn.room_id === r.id ? 'selected' : '' %>>
                    <%= r.name %> (<%= r.capacity %> ppl)
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">Event Type</label>
              <select name="event_type" class="form-select">
                <option value="">Select an event type</option>
                <% eventTypes.forEach(t => { %>
                  <option value="<%= t.name %>" <%= fn.event_type === t.name ? 'selected' : '' %>><%= t.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 border-top pt-2">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <label class="form-label fw-semibold mb-0">Food service times</label>
                <button type="button" class="btn btn-sm btn-outline-primary" id="addCateringTime"><i class="bi bi-plus-lg me-1"></i>Add time</button>
              </div>
              <div id="cateringScheduleRows" class="d-flex flex-column gap-2">
                <% cateringRows.forEach(row => { %>
                  <div class="catering-service-row">
                    <div><label class="form-label mb-1">Time</label><input type="time" name="catering_time" class="form-control" value="<%= row.time || '' %>"></div>
                    <div><label class="form-label mb-1">Service</label><input type="text" name="catering_label" class="form-control" value="<%= row.label || '' %>" placeholder="Morning tea, lunch, dinner..."></div>
                    <div><label class="form-label mb-1">Description</label><input type="text" name="catering_description" class="form-control" value="<%= row.description || '' %>" placeholder="What should be served or prepared"></div>
                    <button type="button" class="btn btn-outline-danger remove-catering-time" title="Remove service time"><i class="bi bi-trash"></i></button>
                  </div>
                <% }) %>
              </div>
              <div class="mt-2"><label class="form-label fw-semibold mb-1">Dietary requirements</label><textarea name="dietary_requirements" class="form-control" rows="2" placeholder="Allergies, dietary needs, quantities, or special preparation"><%= fn.dietary_requirements || '' %></textarea></div>
            </div>

            <div class="col-12">
              <div id="roomConflictWarning" class="alert alert-warning d-none py-2 px-3 mb-0" role="alert"></div>
            </div>

            <div class="col-12" id="roomFacilitiesSection">
              <label class="form-label fw-semibold mb-1">Room facilities</label>
              <div class="d-flex flex-wrap gap-2" id="roomFacilityChoices">
                <% (roomFacilities || []).forEach(facility => { %>
                  <label class="form-check form-check-inline border rounded px-2 py-1 m-0 room-facility-option" data-room-id="<%= facility.room_id %>">
                    <input class="form-check-input ms-0 me-2" type="checkbox" name="facility_ids" value="<%= facility.id %>" <%= facility.selected ? 'checked' : '' %>>
                    <span class="form-check-label"><%= facility.name %></span>
                  </label>
                <% }) %>
                <span class="text-muted small" id="roomFacilitiesEmpty">Choose a room to see its available facilities.</span>
              </div>
            </div>
            <div class="col-12 border-top pt-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold">Contacts</span>
                <% if ((linkedContacts || []).length) { %>
                  <% linkedContacts.forEach(contact => { %><span><%= contact.name %><% if (contact.is_primary) { %> <span class="badge text-bg-light">Primary</span><% } %><% if (contact.email) { %> <span class="text-muted"><%= contact.email %></span><% } %></span><% }) %>
                <% } else { %><span class="text-muted">No contacts linked</span><% } %>
                <button type="button" class="btn btn-sm btn-outline-primary ms-auto" data-open-add-contact><i class="bi bi-person-plus me-1"></i>Add contact</button>
              </div>
            </div>
          </div>
        </section>

        <section class="border rounded bg-white p-3 shadow-sm">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <p class="quote-kicker mb-0">Notes &amp; room setup</p>
            <% if ((allNotes || []).length) { %><span class="small text-muted"><%= allNotes.length %> saved note<%= allNotes.length === 1 ? '' : 's' %></span><% } %>
          </div>
          <% if ((allNotes || []).length) { %>
            <div class="row g-2 mb-2">
              <% allNotes.slice(0, 3).forEach(note => { %>
                <div class="col-lg-4"><div class="border rounded p-2 h-100 small function-edit-note-preview"><%- note.rendered_html || note.content || '<span class="text-muted">Empty note</span>' %></div></div>
              <% }) %>
            </div>
          <% } %>
          <label class="form-label small mb-1">Add room setup information or another note</label>
          <div id="editNoteEditor" style="background: #fff;"></div>
          <input type="hidden" name="notes" id="editNotesHidden" />
          <input type="hidden" name="notes_delta" id="editNotesDeltaHidden" />
        </section>

        <!-- 🔹 STATUS & PAYMENTS SECTION -->
        <section class="border rounded bg-white p-3 shadow-sm">
          <p class="quote-kicker mb-2">Status &amp; payments</p>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Booking status</label>
              <select name="status" class="form-select" id="functionStatusSelect">
                <option value="lead" <%= fn.status === 'lead' ? 'selected' : '' %>>Lead / enquiry</option>
                <option value="confirmed" <%= fn.status === 'confirmed' ? 'selected' : '' %>>Confirmed / booked</option>
                <option value="cancelled" <%= fn.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
              <small class="function-form-help">Use this to show where the booking is in the process.</small>
            </div>

            <div class="col-md-4">
              <label class="form-label">Payment progress</label>
              <div class="payment-stack mt-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="deposit_paid" id="depositPaidEdit" value="on" <%= fn.deposit_paid ? 'checked' : '' %>>
                  <label class="form-check-label" for="depositPaidEdit">Deposit paid</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="fully_paid" id="fullyPaidEdit" value="on" <%= fn.fully_paid ? 'checked' : '' %>>
                  <label class="form-check-label" for="fullyPaidEdit">Fully paid</label>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <label class="form-label">Function Owner</label>
              <select name="owner_id" class="form-select">
                <option value="">Unassigned</option>
                <% (users || []).forEach(u => { %>
                  <option value="<%= u.id %>" <%= fn.owner_id === u.id ? 'selected' : '' %>><%= u.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12" id="cancelReasonGroup" style="<%= fn.status === 'cancelled' ? '' : 'display:none;' %>">
              <label class="form-label">Cancellation reason</label>
              <textarea name="cancelled_reason" class="form-control" rows="2" placeholder="Add a note for why this function was cancelled."><%= fn.cancelled_reason || '' %></textarea>
            </div>
          </div>
        </section>

        <section class="border rounded bg-white p-3 shadow-sm" id="editQuoteSection">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <p class="quote-kicker mb-0">Quote</p>
            <a href="/functions/<%= fn.id_uuid %>/quote" class="btn btn-sm btn-outline-secondary">Advanced quote</a>
          </div>
          <div id="quoteEditMessage" class="alert d-none py-2 px-3 small"></div>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-2" id="editQuoteTable">
              <thead><tr><th style="min-width:190px">Description</th><th style="width:130px">Category</th><th style="width:85px">Qty</th><th style="width:115px">Cost each</th><th style="width:125px">Sale each</th><th class="text-end" style="width:115px">Line total</th><th style="width:80px"></th></tr></thead>
              <tbody>
                <% (quoteLines || []).forEach(line => { %>
                  <tr data-quote-item-id="<%= line.id %>">
                    <td><input type="text" class="form-control form-control-sm quote-line-name" value="<%= line.name %>" aria-label="Quote description"></td><td><input type="text" class="form-control form-control-sm quote-line-category" value="<%= line.category %>" list="quoteCategoryOptions" aria-label="Quote category"></td>
                    <td><input type="number" class="form-control form-control-sm quote-line-qty" min="1" step="1" value="<%= line.quantity %>"></td>
                    <td><input type="number" class="form-control form-control-sm quote-line-cost" min="0" step="0.01" value="<%= Number(line.costEach).toFixed(2) %>"></td>
                    <td><input type="number" class="form-control form-control-sm quote-line-price" min="0" step="0.01" value="<%= Number(line.salePriceEach).toFixed(2) %>"></td>
                    <td class="text-end fw-semibold quote-line-total">$<%= (Number(line.quantity) * Number(line.salePriceEach)).toFixed(2) %></td>
                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger quote-line-remove" title="Remove quote line"><i class="bi bi-trash"></i></button></td>
                  </tr>
                <% }) %>
                <tr id="newQuoteLineRow">
                  <td><input type="text" class="form-control form-control-sm" id="newQuoteName" placeholder="New line description"></td>
                  <td><input type="text" class="form-control form-control-sm" id="newQuoteCategory" value="Other" placeholder="Category" list="quoteCategoryOptions"></td>
                  <td><input type="number" class="form-control form-control-sm" id="newQuoteQty" min="1" step="1" value="1"></td>
                  <td><input type="number" class="form-control form-control-sm" id="newQuoteCost" min="0" step="0.01" value="0"></td>
                  <td><input type="number" class="form-control form-control-sm" id="newQuotePrice" min="0" step="0.01" value="0"></td>
                  <td class="text-end fw-semibold" id="newQuoteLineTotal">$0.00</td><td class="text-end"><button type="button" class="btn btn-sm btn-primary" id="addQuoteLineBtn" title="Add quote line"><i class="bi bi-plus-lg"></i></button></td>
                </tr>
              </tbody>
            </table>
            <datalist id="quoteCategoryOptions"><option value="Room hire"><option value="Food"><option value="Drinks"><option value="Equipment"><option value="Staffing"><option value="Entertainment"><option value="Other"></datalist>
          </div>
          <div class="d-flex flex-wrap justify-content-end gap-3 small border-top pt-2" id="editQuoteTotals" data-discount="<%= Number(quoteTotals.discount_amount || 0) %>" data-paid="<%= Number(quoteTotals.total_paid || 0) %>">
            <span>Cost <strong id="editQuoteCostTotal">$<%= Number(fn.totals_cost || 0).toFixed(2) %></strong></span>
            <span>Sale <strong id="editQuoteSaleTotal">$<%= Number(fn.totals_price || 0).toFixed(2) %></strong></span>
            <span>Profit <strong id="editQuoteProfitTotal">$<%= Number((fn.totals_price || 0) - (fn.totals_cost || 0)).toFixed(2) %></strong></span>
            <span>Paid <strong id="editQuotePaidTotal">$<%= Number(quoteTotals.total_paid || 0).toFixed(2) %></strong></span>
            <span>Balance <strong id="editQuoteBalanceTotal">$<%= Number(quoteTotals.remaining_due || 0).toFixed(2) %></strong></span>
          </div>
        </section>

        <details class="border rounded bg-white p-3 shadow-sm">
          <summary class="quote-kicker">Activity &amp; follow-up</summary>
          <div class="row g-3 pt-3 small">
            <div class="col-lg-3 col-md-6">
              <div class="d-flex justify-content-between align-items-center mb-2"><strong>Tasks</strong><a href="/functions/<%= fn.id_uuid %>/tasks">View all</a></div>
              <% (recentTasks || []).forEach(task => { %><div class="border-top py-2"><span class="d-block"><%= task.title %></span><span class="text-muted"><%= task.status || 'open' %><% if (task.due_at) { %> · <%= new Date(task.due_at).toLocaleDateString('en-NZ') %><% } %></span></div><% }) %>
              <% if (!(recentTasks || []).length) { %><span class="text-muted">No tasks.</span><% } %>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="d-flex justify-content-between align-items-center mb-2"><strong>Communications</strong><a href="/functions/<%= fn.id_uuid %>/communications">View all</a></div>
              <% (recentCommunications || []).forEach(item => { %><div class="border-top py-2"><span class="d-block text-truncate"><%= item.subject || 'Message' %></span><span class="text-muted"><%= item.type || 'message' %><% if (item.activity_at) { %> · <%= new Date(item.activity_at).toLocaleDateString('en-NZ') %><% } %></span></div><% }) %>
              <% if (!(recentCommunications || []).length) { %><span class="text-muted">No communications.</span><% } %>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="d-flex justify-content-between align-items-center mb-2"><strong>Payments</strong><a href="/functions/<%= fn.id_uuid %>/quote">Manage</a></div>
              <% (recentPayments || []).forEach(payment => { %><div class="border-top py-2 d-flex justify-content-between gap-2"><span><%= payment.method || 'Payment' %><% if (payment.paid_on) { %><span class="text-muted d-block"><%= new Date(payment.paid_on).toLocaleDateString('en-NZ') %></span><% } %></span><strong>$<%= Number(payment.amount || 0).toFixed(2) %></strong></div><% }) %>
              <% if (!(recentPayments || []).length) { %><span class="text-muted">No payments recorded.</span><% } %>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="d-flex justify-content-between align-items-center mb-2"><strong>Feedback</strong><a href="/feedback">Open feedback</a></div>
              <% (recentFeedback || []).forEach(entry => { %><div class="border-top py-2"><span class="d-block"><%= entry.rating_overall ? `${entry.rating_overall}/5` : 'Awaiting rating' %></span><span class="text-muted"><%= entry.status || 'pending' %><% if (entry.completed_at || entry.sent_at) { %> · <%= new Date(entry.completed_at || entry.sent_at).toLocaleDateString('en-NZ') %><% } %></span></div><% }) %>
              <% if (!(recentFeedback || []).length) { %><span class="text-muted">No feedback yet.</span><% } %>
            </div>
          </div>
        </details>

        <!-- 🔹 ADDITIONAL INFO SECTION -->
        <details class="border rounded bg-white p-3 shadow-sm">
          <summary class="quote-kicker">Additional details &amp; room allocations</summary>
          <div class="pt-3">
          <p class="quote-kicker mb-2">Additional info (optional)</p>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Attendees</label>
              <input type="number" name="attendees" class="form-control" value="<%= fn.attendees || '' %>" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Budget ($)</label>
              <input type="number" step="0.01" name="budget" class="form-control" value="<%= fn.budget || '' %>" />
            </div>
          </div>
          </div>

        <div class="border-top pt-3 mt-3">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <p class="quote-kicker mb-0">Additional room allocations</p>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addAllocationRow">
              <i class="bi bi-plus-lg me-1"></i>Add room allocation
            </button>
          </div>
          <p class="text-muted small mb-2">Use this for extra rooms, split timings, setup windows, or overflow spaces.</p>
          <div id="allocationError" class="alert alert-warning d-none py-2 px-3 small" role="alert"></div>
          <div id="allocationRows" class="d-flex flex-column gap-2">
            <% (roomAllocations || []).forEach(a => { %>
              <div class="border rounded-3 p-3 allocation-row">
                <div class="row g-3 align-items-end">
                  <div class="col-md-4">
                    <label class="form-label small">Room</label>
                    <select name="allocation_room_id" class="form-select">
                      <option value="">Select room</option>
                      <% rooms.forEach(r => { %>
                        <option value="<%= r.id %>" <%= String(a.room_id) === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small">Start date</label>
                    <input type="date" name="allocation_start_date" class="form-control" value="<%= a.start_at ? new Date(a.start_at).toISOString().slice(0,10) : '' %>">
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small">Start time</label>
                    <input type="time" name="allocation_start_time" class="form-control" value="<%= a.start_at ? new Date(a.start_at).toISOString().slice(11,16) : '' %>">
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small">End date</label>
                    <input type="date" name="allocation_end_date" class="form-control" value="<%= a.end_at ? new Date(a.end_at).toISOString().slice(0,10) : '' %>">
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small">End time</label>
                    <input type="time" name="allocation_end_time" class="form-control" value="<%= a.end_at ? new Date(a.end_at).toISOString().slice(11,16) : '' %>">
                  </div>
                  <div class="col-md-10">
                    <label class="form-label small">Notes</label>
                    <input type="text" name="allocation_notes" class="form-control" placeholder="Optional notes" value="<%= a.notes || '' %>">
                  </div>
                  <div class="col-md-2 text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-allocation">Remove</button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        </details>

        <div class="mt-4 d-flex justify-content-end gap-2">
          <a href="/functions" class="btn btn-outline-secondary">Back</a>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>

    <template id="cateringTimeTemplate">
      <div class="catering-service-row">
        <div><label class="form-label mb-1">Time</label><input type="time" name="catering_time" class="form-control"></div>
        <div><label class="form-label mb-1">Service</label><input type="text" name="catering_label" class="form-control" placeholder="Morning tea, lunch, dinner..."></div>
        <div><label class="form-label mb-1">Description</label><input type="text" name="catering_description" class="form-control" placeholder="What should be served or prepared"></div>
        <button type="button" class="btn btn-outline-danger remove-catering-time" title="Remove service time"><i class="bi bi-trash"></i></button>
      </div>
    </template>

<div class="modal fade" id="editRunSheetModal" tabindex="-1" aria-labelledby="editRunSheetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="editRunSheetModalLabel">Build run sheet</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
      <div class="mb-3"><p class="fw-semibold small mb-2">Notes</p><div class="d-flex flex-wrap gap-2">
        <% (allNotes || []).forEach(note => { %><label class="form-check border rounded px-2 py-1 m-0"><input class="form-check-input ms-0 me-2" type="checkbox" name="run_sheet_notes" value="<%= note.id %>" checked><span class="form-check-label small"><%= note.note_type || 'Note' %> · <%= new Date(note.created_at).toLocaleDateString('en-NZ') %></span></label><% }) %>
        <% if (!(allNotes || []).length) { %><span class="text-muted small">No saved notes.</span><% } %>
      </div></div>
      <div class="mb-3"><p class="fw-semibold small mb-2">Quote categories</p><div class="d-flex flex-wrap gap-2">
        <% [...new Set((quoteLines || []).map(line => line.category || 'Other'))].forEach(category => { %><label class="form-check border rounded px-2 py-1 m-0"><input class="form-check-input ms-0 me-2" type="checkbox" name="run_sheet_categories" value="<%= category %>" checked><span class="form-check-label small"><%= category %></span></label><% }) %>
        <% if (!(quoteLines || []).length) { %><span class="text-muted small">No quote categories.</span><% } %>
