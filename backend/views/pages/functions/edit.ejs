<link rel="stylesheet" href="/vendor/quill/quill.snow.css">
<script src="/vendor/quill/quill.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const editorEl = document.getElementById("editNoteEditor");
    const formEl = document.querySelector('form[action="/functions/<%= fn.id_uuid %>/edit"]');
    if (!editorEl || !formEl || typeof Quill === "undefined") return;

    const quill = new Quill("#editNoteEditor", {
      theme: "snow",
      modules: {
        toolbar: [
          ["bold", "italic", "underline"],
          [{ header: [2, 3, false] }],
          [{ list: "ordered" }, { list: "bullet" }],
          ["link", "image"],
          ["clean"],
        ],
      },
    });

    const syncEditorHeight = () => {
      const container = quill.container;
      const editor = quill.root;
      if (!container || !editor) return;
      container.style.height = "auto";
      editor.style.height = "auto";
      const nextHeight = Math.max(120, editor.scrollHeight + 8);
      container.style.height = `${nextHeight}px`;
    };

    quill.on("text-change", syncEditorHeight);
    // Run once after init in case content is pasted/loaded later.
    setTimeout(syncEditorHeight, 0);

    formEl.addEventListener("submit", () => {
      const html = quill.root.innerHTML.trim();
      const isEmpty = html === "<p><br></p>" || html === "";
      document.getElementById("editNotesHidden").value = isEmpty ? "" : html;
      document.getElementById("editNotesDeltaHidden").value = isEmpty ? "" : JSON.stringify(quill.getContents());
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const roomSelect = document.querySelector('[name="room_id"]');
    const facilityOptions = [...document.querySelectorAll(".room-facility-option")];
    const facilitiesEmpty = document.getElementById("roomFacilitiesEmpty");
    const refreshFacilities = () => {
      const roomId = roomSelect?.value || "";
      let visibleCount = 0;
      facilityOptions.forEach((option) => {
        const visible = Boolean(roomId) && option.dataset.roomId === roomId;
        option.classList.toggle("d-none", !visible);
        option.querySelector("input").disabled = !visible;
        if (visible) visibleCount += 1;
      });
      if (facilitiesEmpty) {
        facilitiesEmpty.textContent = roomId
          ? "No facilities have been configured for this room."
          : "Choose a room to see its available facilities.";
        facilitiesEmpty.classList.toggle("d-none", visibleCount > 0);
      }
    };
    roomSelect?.addEventListener("change", refreshFacilities);
    refreshFacilities();

    const money = (value) => `$${Number(value || 0).toFixed(2)}`;
    const quoteRows = () => [...document.querySelectorAll("tr[data-quote-item-id]")];
    const refreshQuoteTotals = () => {
      let cost = 0;
      let sale = 0;
      quoteRows().forEach((row) => {
        const qty = Number(row.querySelector(".quote-line-qty")?.value) || 0;
        const costEach = Number(row.querySelector(".quote-line-cost")?.value) || 0;
        const priceEach = Number(row.querySelector(".quote-line-price")?.value) || 0;
        cost += qty * costEach;
        sale += qty * priceEach;
        row.querySelector(".quote-line-total").textContent = money(qty * priceEach);
      });
      const draftQty = Number(document.getElementById("newQuoteQty")?.value) || 0;
      const draftCost = Number(document.getElementById("newQuoteCost")?.value) || 0;
      const draftPrice = Number(document.getElementById("newQuotePrice")?.value) || 0;
      const hasDraft = Boolean(document.getElementById("newQuoteName")?.value.trim());
      document.getElementById("newQuoteLineTotal").textContent = money(draftQty * draftPrice);
      if (hasDraft) {
        cost += draftQty * draftCost;
        sale += draftQty * draftPrice;
      }
      document.getElementById("editQuoteCostTotal").textContent = money(cost);
      document.getElementById("editQuoteSaleTotal").textContent = money(sale);
      document.getElementById("editQuoteProfitTotal").textContent = money(sale - cost);
      const totals = document.getElementById("editQuoteTotals");
      const discount = Number(totals?.dataset.discount) || 0;
      const paid = Number(totals?.dataset.paid) || 0;
      document.getElementById("editQuotePaidTotal").textContent = money(paid);
      document.getElementById("editQuoteBalanceTotal").textContent = money(sale - discount - paid);
    };
    const request = async (url, body) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.success === false) throw new Error(payload.error || "Quote update failed");
      return payload;
    };
    const showQuoteError = (error) => {
      const message = document.getElementById("quoteEditMessage");
      message.textContent = error.message || String(error);
      message.className = "alert alert-danger py-2 px-3 small";
    };
    const clearQuoteError = () => {
      const message = document.getElementById("quoteEditMessage");
      message.className = "alert d-none py-2 px-3 small";
      message.textContent = "";
    };
    const dirtyQuoteRows = new Set();
    const quoteSaveTimers = new Map();
    const quoteSaveChains = new Map();

    const persistQuoteRow = (row) => {
      const itemId = row.dataset.quoteItemId;
      const payload = {
        name: row.querySelector(".quote-line-name").value.trim(),
        category: row.querySelector(".quote-line-category").value || "Other",
        qty: Number(row.querySelector(".quote-line-qty").value) || 1,
        cost_each: Number(row.querySelector(".quote-line-cost").value) || 0,
        unit_price: Number(row.querySelector(".quote-line-price").value) || 0,
      };
      if (!payload.name) {
        const error = new Error("Quote description is required");
        showQuoteError(error);
        return Promise.reject(error);
      }

      const previous = quoteSaveChains.get(row) || Promise.resolve();
      const next = previous
        .catch(() => {})
        .then(() => request(`/functions/proposal-items/${itemId}/update-line`, payload))
        .then(() => {
          if (!quoteSaveTimers.has(row)) {
            dirtyQuoteRows.delete(row);
            row.classList.remove("table-warning");
          }
          clearQuoteError();
          refreshQuoteTotals();
        })
        .catch((error) => {
          row.classList.add("table-warning");
          showQuoteError(error);
          throw error;
        });
      quoteSaveChains.set(row, next);
      return next;
    };

    const queueQuoteRowSave = (row, immediate = false) => {
      dirtyQuoteRows.add(row);
      row.classList.add("table-warning");
      clearTimeout(quoteSaveTimers.get(row));
      quoteSaveTimers.delete(row);
      if (immediate) return persistQuoteRow(row);
      const timer = setTimeout(() => {
        quoteSaveTimers.delete(row);
        persistQuoteRow(row).catch(() => {});
      }, 500);
      quoteSaveTimers.set(row, timer);
      return Promise.resolve();
    };

    window.waitForQuoteUpdates = async () => {
      const rowsToFlush = [...dirtyQuoteRows];
      rowsToFlush.forEach((row) => {
        clearTimeout(quoteSaveTimers.get(row));
        quoteSaveTimers.delete(row);
        persistQuoteRow(row).catch(() => {});
      });
      await Promise.all([...quoteSaveChains.values()]);
    };

    quoteRows().forEach((row) => {
      const itemId = row.dataset.quoteItemId;
      const inputs = [...row.querySelectorAll("input")];
      inputs.forEach((input) => {
        input.addEventListener("input", () => {
          refreshQuoteTotals();
          queueQuoteRowSave(row);
        });
        input.addEventListener("change", () => {
          queueQuoteRowSave(row, true).catch(() => {});
        });
      });
      row.querySelector(".quote-line-remove")?.addEventListener("click", async () => {
        try {
          await request(`/functions/<%= fn.id_uuid %>/quote/remove-item`, { item_id: Number(itemId) });
          row.remove();
          refreshQuoteTotals();
        } catch (error) {
          showQuoteError(error);
        }
      });
    });

    document.getElementById("addQuoteLineBtn")?.addEventListener("click", async () => {
      const button = document.getElementById("addQuoteLineBtn");
      button.disabled = true;
      try {
        await request(`/functions/<%= fn.id_uuid %>/quote/add-item`, {
          name: document.getElementById("newQuoteName").value,
          category: document.getElementById("newQuoteCategory").value || "Other",
          qty: Number(document.getElementById("newQuoteQty").value) || 1,
          cost_each: Number(document.getElementById("newQuoteCost").value) || 0,
          unit_price: Number(document.getElementById("newQuotePrice").value) || 0,
        });
        window.location.reload();
      } catch (error) {
        showQuoteError(error);
        button.disabled = false;
      }
    });
    ["newQuoteName", "newQuoteQty", "newQuoteCost", "newQuotePrice"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", refreshQuoteTotals);
    });
    refreshQuoteTotals();

    document.getElementById("editRunSheetPreviewBtn")?.addEventListener("click", async () => {
      try {
        await window.waitForQuoteUpdates?.();
      } catch (error) {
        showQuoteError(error);
        return;
      }
      const params = new URLSearchParams();
      const notes = [...document.querySelectorAll('[name="run_sheet_notes"]:checked')].map((input) => input.value);
      const categories = [...document.querySelectorAll('[name="run_sheet_categories"]:checked')].map((input) => input.value);
      params.set("notes", notes.length ? notes.join(",") : "none");
      if (categories.length) categories.forEach((category) => params.append("categories", category));
      else params.set("categories", "none");
      params.set("facilities", document.getElementById("runSheetFacilities").checked);
      params.set("catering", document.getElementById("runSheetCatering").checked);
      params.set("dietary", document.getElementById("runSheetDietary").checked);
      params.set("quantities", document.getElementById("runSheetQuantities").checked);
      params.set("costs", document.getElementById("runSheetCosts").checked);
      params.set("prices", document.getElementById("runSheetPrices").checked);
      params.set("invoice", document.getElementById("runSheetInvoice").checked);
      window.open(`/functions/<%= fn.id_uuid %>/run-sheet?${params.toString()}`, "_blank");
    });
  });
</script>

