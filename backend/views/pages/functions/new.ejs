<!-- pages/functions/new.ejs -->
<% locals.layout = 'layouts/main'; %>

<div class="function-body py-4 px-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="page-title mb-0">Create Function</h1>
    <a href="/functions" class="btn btn-outline-secondary">Back to Dashboard</a>
  </div>

  <% if (formError) { %>
    <div class="alert alert-danger"><%= formError %></div>
  <% } %>

  <% const v = formValues || {}; %>
  <% const selectedWeekdaysRaw = v.recurrence_weekdays ?? v["recurrence_weekdays[]"] ?? []; %>
  <% const selectedWeekdays = Array.isArray(selectedWeekdaysRaw) ? selectedWeekdaysRaw.map(String) : String(selectedWeekdaysRaw || "").split(",").map(function(x){return x.trim();}).filter(Boolean); %>

  <div class="function-form-hero mb-3">
    <div>
      <h2 class="mb-1">Quick booking entry</h2>
      <p class="mb-0">Capture the essentials first. Use Lead for enquiries, Confirmed once the booking is set, and Cancelled if it no longer goes ahead.</p>
    </div>
    <div class="function-form-hero-badges">
      <span class="function-form-pill">Lead</span>
      <span class="function-form-pill">Confirmed</span>
      <span class="function-form-pill">Cancelled</span>
    </div>
  </div>

  <form method="POST" action="/functions/new" class="card p-3 shadow-sm function-form-card">
    <!-- 🔹 ESSENTIALS SECTION -->
    <div class="mb-4">
      <p class="quote-kicker mb-2">Essential details</p>
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Event Name *</label>
          <input type="text" name="event_name" class="form-control" value="<%= v.event_name || '' %>" required />
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold">Date *</label>
          <input type="date" id="fn_event_date" name="event_date" class="form-control"
                 value="<%= v.event_date || '' %>" />
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold">End date</label>
          <input type="date" id="fn_end_date" name="end_date" class="form-control"
                 value="<%= v.end_date || '' %>" />
        </div>

        <div class="col-md-3">
          <label class="form-label">Start time</label>
          <input type="time" name="start_time" class="form-control" value="<%= v.start_time || '' %>" />
        </div>

        <div class="col-md-3">
          <label class="form-label">End time</label>
          <input type="time" name="end_time" class="form-control" value="<%= v.end_time || '' %>" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Room / Space</label>
          <select name="room_id" class="form-select">
            <option value="">Select a room</option>
            <% (rooms || []).forEach(r => { %>
              <option value="<%= r.id %>" <%= String(v.room_id || '') === String(r.id) ? 'selected' : '' %>>
                <%= r.name %><% if (r.capacity) { %> (<%= r.capacity %> ppl)<% } %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">Event Type</label>
          <select name="event_type" class="form-select">
            <option value="">Select type</option>
            <% (eventTypes || []).forEach(t => { %>
              <option value="<%= t.name %>" <%= v.event_type === t.name ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <div id="roomConflictWarningNew" class="alert alert-warning d-none py-2 px-3 mb-0" role="alert"></div>
        </div>
      </div>
    </div>

    <!-- 🔹 STATUS & PAYMENTS SECTION -->
    <div class="border-top pt-4 mb-4">
      <p class="quote-kicker mb-2">Status &amp; payments</p>
      <div class="row g-2">
        <div class="col-md-4">
          <label class="form-label fw-semibold">Booking status *</label>
          <select name="status" class="form-select" id="functionStatusSelectNew">
            <option value="lead" <%= (v.status || 'lead') === 'lead' ? 'selected' : '' %>>Lead / enquiry</option>
            <option value="confirmed" <%= (v.status || 'lead') === 'confirmed' ? 'selected' : '' %>>Confirmed / booked</option>
            <option value="cancelled" <%= (v.status || 'lead') === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
          <small class="function-form-help">Lead for enquiries, Confirmed once the booking is set.</small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Payment progress</label>
          <div class="payment-stack mt-2">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="deposit_paid" id="depositPaidNew" value="on" <%= v.deposit_paid ? 'checked' : '' %>>
              <label class="form-check-label" for="depositPaidNew">Deposit paid</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="fully_paid" id="fullyPaidNew" value="on" <%= v.fully_paid ? 'checked' : '' %>>
              <label class="form-check-label" for="fullyPaidNew">Fully paid</label>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label">Owner</label>
          <select name="owner_id" class="form-select">
            <option value="">Unassigned</option>
            <% (users || []).forEach(u => { %>
              <option value="<%= u.id %>" <%= String(v.owner_id || '') === String(u.id) ? 'selected' : '' %>>
                <%= u.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-12" id="cancelReasonGroupNew" style="<%= (v.status || 'lead') === 'cancelled' ? '' : 'display:none;' %>">
          <label class="form-label">Cancellation reason</label>
          <textarea name="cancelled_reason" class="form-control" rows="2" placeholder="Add a note for why this function was cancelled."><%= v.cancelled_reason || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- 🔹 ADDITIONAL INFO SECTION -->
    <div class="border-top pt-4 mb-4">
      <p class="quote-kicker mb-2">Additional info (optional)</p>
      <div class="row g-2">
        <div class="col-md-4">
          <label class="form-label">Attendees</label>
          <input type="number" name="attendees" class="form-control" value="<%= v.attendees || '' %>" />
        </div>

        <div class="col-md-4">
          <label class="form-label">Budget ($)</label>
          <input type="number" step="0.01" name="budget" class="form-control" value="<%= v.budget || '' %>" />
        </div>
      </div>
    </div>

    <!-- 🔹 NOTES SECTION -->
    <div class="border-top pt-4 mb-4">
      <p class="quote-kicker mb-2">Notes for this booking</p>
      <label class="form-label">Add any details, special requests, or follow-up notes</label>
      <div id="noteEditorNew" style="min-height:140px; background:#fff;"></div>
      <input type="hidden" name="notes" id="notesHiddenNew" />
      <input type="hidden" name="notes_delta" id="notesDeltaNew" />
    </div>

    <div class="d-flex justify-content-end gap-2">
      <a href="/functions" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Create Function</button>
    </div>

    <!-- Quill assets and init: use local vendor files -->
    <link rel="stylesheet" href="/vendor/quill/quill.snow.css">
    <script src="/vendor/quill/quill.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const editorEl = document.getElementById('noteEditorNew');
        if (!editorEl) return;
        const initial = `<%= (v.notes || '') %>`;
        const quill = new Quill('#noteEditorNew', {
          theme: 'snow',
          modules: { toolbar: [['bold','italic','underline'], [{ header: [2,3,false] }], [{ list: 'ordered'}, { list: 'bullet'}], ['link','image'], ['clean']] }
        });
        // Load initial HTML
        if (initial) quill.clipboard.dangerouslyPasteHTML(initial);

        const form = document.querySelector('form[action="/functions/new"]');
        if (!form) return;
        form.addEventListener('submit', () => {
          document.getElementById('notesHiddenNew').value = quill.root.innerHTML.trim();
          document.getElementById('notesDeltaNew').value = JSON.stringify(quill.getContents());
        });
      });
    </script>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const statusSelect = document.getElementById("functionStatusSelectNew");
    const cancelGroup = document.getElementById("cancelReasonGroupNew");
    if (!statusSelect || !cancelGroup) return;
    const toggleCancelReason = () => {
      cancelGroup.style.display = statusSelect.value === "cancelled" ? "" : "none";
    };
    statusSelect.addEventListener("change", toggleCancelReason);
    toggleCancelReason();
  });

  document.addEventListener("DOMContentLoaded", () => {
    const startInput = document.getElementById("fn_event_date");
    const endInput   = document.getElementById("fn_end_date");
    if (!startInput || !endInput) return;
    startInput.addEventListener("change", () => {
      if (!endInput.value) endInput.value = startInput.value;
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector('form[action="/functions/new"]');
    const warningEl = document.getElementById("roomConflictWarningNew");
    if (!form || !warningEl) return;

    const roomInput = form.querySelector('[name="room_id"]');
    const eventDateInput = form.querySelector('[name="event_date"]');
    const endDateInput = form.querySelector('[name="end_date"]');
    const startTimeInput = form.querySelector('[name="start_time"]');
    const endTimeInput = form.querySelector('[name="end_time"]');

    let debounceTimer = null;
    let inFlight = false;

    const setWarning = (message) => {
      if (!message) {
        warningEl.classList.add("d-none");
        warningEl.textContent = "";
        return;
      }
      warningEl.textContent = message;
      warningEl.classList.remove("d-none");
    };

    const checkConflicts = async () => {
      if (inFlight) return;
      const roomId = roomInput?.value || "";
      const eventDate = eventDateInput?.value || "";
      if (!roomId || !eventDate) {
        setWarning("");
        return;
      }

      inFlight = true;
      try {
        const res = await fetch('/functions/room-conflicts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            room_id: roomId,
            event_date: eventDate,
            end_date: endDateInput?.value || eventDate,
            start_time: startTimeInput?.value || null,
            end_time: endTimeInput?.value || null,
            allocations: [],
          }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Conflict check failed');
        setWarning(data.hasConflicts ? (data.message || 'Room conflict detected.') : '');
      } catch (err) {
        console.error(err);
      } finally {
        inFlight = false;
      }
    };

    const scheduleCheck = () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(checkConflicts, 220);
    };

    [roomInput, eventDateInput, endDateInput, startTimeInput, endTimeInput].forEach((el) => {
      el?.addEventListener('change', scheduleCheck);
      el?.addEventListener('input', scheduleCheck);
    });

    checkConflicts();
  });
</script>
