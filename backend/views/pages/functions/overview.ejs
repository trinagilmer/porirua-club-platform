<% locals.layout = 'layouts/main'; %>

<%
  var contacts = linkedContacts || [];
  var primaryContact =
    contacts.find(function (c) {
      return c.is_primary;
    }) || contacts[0] || {};
  var secondaryContacts = contacts.filter(function (c) {
    return c !== primaryContact;
  });
  var fieldAudit = typeof overviewAudit !== "undefined" ? overviewAudit : {};
  var notesList = typeof overviewNotes !== "undefined" ? overviewNotes : [];
  var allNotes = typeof notes !== "undefined" ? notes : [];
  var menuSummary = typeof overviewMenus !== "undefined" ? overviewMenus : [];
  var financialTotals = typeof totals !== "undefined" ? totals : {};
  var paymentHistory =
    typeof payments !== "undefined" && Array.isArray(payments) ? payments : [];
  var proposalPreview = typeof proposalPreviewLink !== "undefined" ? proposalPreviewLink : null;
  var proposalAudit = typeof proposalAuditData !== "undefined" ? proposalAuditData : null;
  var communicationsFeed =
    typeof communications !== "undefined"
      ? communications
      : grouped
      ? Object.values(grouped).flat()
      : [];
  var categoriesList = Array.isArray(categories) ? categories : [];
  var menusList = Array.isArray(menus) ? menus : [];
  var eventTypeList = Array.isArray(eventTypes) ? eventTypes : [];

  function nzDate(value) {
    if (!value) return "-";
    return new Date(value).toLocaleDateString("en-NZ");
  }
  function nzDateRange(startValue, endValue) {
    if (!startValue) return "-";
    const start = nzDate(startValue);
    if (!endValue) return start;
    const end = nzDate(endValue);
    if (!end || end === start) return start;
    return `${start} - ${end}`;
  }
  function nzTime(value) {
    if (!value) return "--:--";
    var dateValue = value;
    if (typeof value === "string" && value.indexOf("T") === -1) {
      dateValue = "1970-01-01T" + value;
    }
    var d = new Date(dateValue);
    if (isNaN(d.getTime())) return "--:--";
    return d.toLocaleTimeString("en-NZ", { hour: "2-digit", minute: "2-digit" });
  }
  function formatStamp(audit, field) {
    field = field || "updated_at";
    if (!audit) return "-";
    const stamp = audit[field] || audit.date || audit.timestamp;
    const label =
      audit.name ||
      audit.updated_by_name ||
      audit.display ||
      audit.initials ||
      audit.updated_by ||
      audit.user ||
      "";
    if (!stamp && !label) return "-";
    const formatted = stamp ? new Date(stamp).toLocaleDateString("en-NZ") : "-";
    return label ? (formatted + " (" + label + ")").trim() : formatted;
  }
  function formatUpdated(audit) {
    return formatStamp(audit, "updated_at");
  }
  function formatCreated(audit) {
    return formatStamp(audit, "created_at");
  }
  function formatDateInput(value) {
    if (!value) return "";
    var dateObj = new Date(value);
    if (isNaN(dateObj.getTime())) return "";
    var tzOffsetMs = dateObj.getTimezoneOffset() * 60000;
    var localDate = new Date(dateObj.getTime() - tzOffsetMs);
    return localDate.toISOString().split("T")[0];
  }
%>

<div class="function-body function-overview py-4 px-4">

  <%
    const canManage = user && ['admin','owner'].includes((user.role || '').toLowerCase());
    const allocations = Array.isArray(roomAllocations) ? roomAllocations : [];
  %>

  <!-- ── 1. BOOKING DETAIL ── -->
  <section class="overview-card overview-detail mb-3">
    <div class="overview-card__header">
      <div>
        <p class="overview-card__title mb-0">Booking detail</p>
        <p class="text-muted small mb-0">Quick booking summary</p>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <a href="/functions/<%= fn.id_uuid %>/edit" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="POST" action="/functions/<%= fn.id_uuid %>/clone" class="d-inline" onsubmit="return confirm('Create a clone of this function?');">
          <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-files me-1"></i>Clone
          </button>
        </form>
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#runSheetModal">
          <i class="bi bi-clipboard-check me-1"></i>Run sheet
        </button>
        <% if (canManage) { %>
          <button class="btn btn-sm btn-outline-secondary" data-action="archive-function">
            <i class="bi bi-archive me-1"></i>Archive
          </button>
          <button class="btn btn-sm btn-outline-danger" data-action="delete-function">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        <% } %>
      </div>
    </div>

    <div class="overview-detail-grid">
      <div class="overview-detail-col">
        <div class="overview-detail-row">
          <span class="overview-detail-label">Status</span>
          <span class="badge text-uppercase
            <%= fn.status === 'confirmed' ? 'bg-success' : fn.status === 'cancelled' ? 'bg-danger' : 'bg-secondary' %>">
            <%= fn.status || 'lead' %>
          </span>
        </div>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Primary contact</span>
          <span>
            <% if (primaryContact && primaryContact.name) { %>
              <strong><%= primaryContact.name %></strong>
              <span class="text-muted small d-block"><%= primaryContact.email || '' %><% if (primaryContact.phone) { %> · <%= primaryContact.phone %><% } %></span>
            <% } else { %>
              <span class="text-muted">Not assigned</span>
            <% } %>
          </span>
        </div>
        <% if (secondaryContacts.length) { %>
          <div class="overview-detail-row">
            <span class="overview-detail-label">Other contacts</span>
            <span><%= secondaryContacts.map(function(c){ return c.name; }).join(', ') %></span>
          </div>
        <% } %>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Event type</span>
          <select class="form-select form-select-sm overview-inline-edit" data-field="event_type">
            <option value="">Not set</option>
            <% eventTypeList.forEach(function(t) { %>
              <option value="<%= t.name %>" <%= fn.event_type === t.name ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Attendees</span>
          <input type="number" min="0" class="form-control form-control-sm overview-inline-edit" data-field="attendees" value="<%= fn.attendees || 0 %>">
        </div>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Budget</span>
          <input type="number" step="0.01" min="0" class="form-control form-control-sm overview-inline-edit" data-field="budget" value="<%= fn.budget || '' %>" placeholder="Not set">
        </div>
        <% if (fn.status === 'cancelled' && fn.cancelled_reason) { %>
          <div class="overview-detail-row">
            <span class="overview-detail-label">Cancellation reason</span>
            <span class="text-danger"><%= fn.cancelled_reason %></span>
          </div>
        <% } %>
      </div>

      <div class="overview-detail-col">
        <div class="overview-detail-row">
          <span class="overview-detail-label">Date</span>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <input type="date" class="form-control form-control-sm overview-inline-edit" data-field="event_date" value="<%= formatDateInput(fn.event_date) %>">
            <span class="text-muted small">to</span>
            <input type="date" class="form-control form-control-sm overview-inline-edit" data-field="end_date" value="<%= formatDateInput(fn.end_date) %>">
          </div>
        </div>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Time</span>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <input type="time" class="form-control form-control-sm overview-inline-edit" data-field="start_time" value="<%= fn.start_time ? String(fn.start_time).slice(0,5) : '' %>">
            <span class="text-muted small">to</span>
            <input type="time" class="form-control form-control-sm overview-inline-edit" data-field="end_time" value="<%= fn.end_time ? String(fn.end_time).slice(0,5) : '' %>">
          </div>
        </div>
        <div class="overview-detail-row">
          <span class="overview-detail-label">Room</span>
          <select class="form-select form-select-sm overview-inline-edit" data-field="room_id">
            <option value="">Unassigned</option>
            <% (rooms || []).forEach(function(r) { %>
              <option value="<%= r.id %>" <%= String(fn.room_id || '') === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <% if (allocations.length) { %>
          <div class="overview-detail-row">
            <span class="overview-detail-label">Additional rooms</span>
            <span>
              <% allocations.forEach(function(a) { %>
                <div>
                  <strong><%= a.room_name %></strong>
                  <% if (a.start_at || a.end_at) { %>
                    <span class="text-muted small">
                      · <%= a.start_at ? nzTime(a.start_at) : 'start' %> → <%= a.end_at ? nzTime(a.end_at) : 'end' %>
                    </span>
                  <% } %>
                </div>
              <% }) %>
            </span>
          </div>
        <% } %>
      </div>
    </div>

    <% if (linkedEntertainment && linkedEntertainment.length) { %>
      <div class="alert alert-info d-flex flex-column gap-1 py-2 mt-3 mb-0">
        <div class="small text-muted text-uppercase">Linked entertainment</div>
        <% linkedEntertainment.forEach(function(evt) { %>
          <div>
            <a href="/entertainment/<%= evt.slug || evt.id %>" class="text-decoration-none fw-semibold"><%= evt.title %></a>
            <% if (evt.start_at) { %><span class="text-muted small"> · <%= new Date(evt.start_at).toLocaleDateString('en-NZ') %></span><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- ── 2. NOTES & CALLS ── -->
  <section class="overview-card overview-notes mb-3">
    <div class="overview-card__header">
      <p class="overview-card__title mb-0">Notes &amp; calls</p>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" data-action="add-note" data-function="<%= fn.id_uuid %>">Add note</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="log-call" data-function="<%= fn.id_uuid %>">Log call</button>
      </div>
    </div>
    <div class="notes-list">
      <% if (!notesList.length) { %>
        <div class="empty-state">No notes logged yet.</div>
      <% } else { %>
        <% notesList.forEach(function (note) { %>
          <article class="note-card" data-note-id="<%= note.id %>">
            <div class="note-card__head">
              <div>
                <span class="note-card__type">
                  <i class="bi <%= note.type === 'call' ? 'bi-telephone' : 'bi-journal-text' %> me-1"></i>
                  <%= note.title || note.note_type || 'Untitled' %>
                </span>
                <% if (note.contact_name) { %>
                  <span class="badge bg-light text-dark ms-2"><%= note.contact_name %></span>
                <% } %>
              </div>
              <a href="/functions/<%= fn.id_uuid %>/notes?focus=<%= note.id %>#note-<%= note.id %>" class="btn btn-link btn-sm p-0">Open</a>
            </div>
            <p class="note-card__preview mb-2"><%= (note.preview || note.content || '').substring(0, 140) %><%= (note.preview || note.content || '').length > 140 ? '…' : '' %></p>
            <div class="note-card__meta">
              <span>Updated <%= nzDate(note.updated_at || note.created_at) %></span>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </section>

  <!-- ── 3. ROOM HIRE ── -->
  <section class="overview-card overview-room-charges mb-3">
    <div class="overview-card__header">
      <div>
        <p class="overview-card__title mb-0">Room hire</p>
        <% const roomSummary = typeof roomChargeSummary !== 'undefined' ? roomChargeSummary : { has_items: false, all_matched: false, mismatch_count: 0, items: [], booked_room_name: fn.room_name || '' }; %>
        <span class="text-muted small"><%= roomSummary.booked_room_name || 'Unassigned' %>
          <% if (roomSummary.has_items && roomSummary.all_matched) { %>
            · <span class="text-success">matched</span>
          <% } else if (roomSummary.has_items && !roomSummary.all_matched) { %>
            · <span class="text-warning"><%= roomSummary.mismatch_count %> mismatch</span>
          <% } %>
        </span>
      </div>
      <a href="/functions/<%= fn.id_uuid %>/quote" class="btn btn-sm btn-outline-primary">Open quote</a>
    </div>
    <% if (!roomSummary.has_items) { %>
      <div class="empty-state">No room charge lines added to the quote yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Room charge</th>
              <th>Quote room</th>
              <th class="text-end">Qty</th>
              <th class="text-end">Unit</th>
              <th class="text-end">Total</th>
            </tr>
          </thead>
          <tbody>
            <% roomSummary.items.forEach(function(item) { %>
              <tr>
                <td><%= item.label %></td>
                <td>
                  <%= item.room_name || 'Not tagged' %>
                  <% if (!item.room_match) { %><span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-1">check</span><% } %>
                </td>
                <td class="text-end"><%= item.qty %></td>
                <td class="text-end">$<%= Number(item.unit_price || 0).toFixed(2) %></td>
                <td class="text-end">$<%= Number(item.total || 0).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <!-- ── 4. MENUS ── -->
  <section class="overview-card overview-menus mb-3">
    <div class="overview-card__header">
      <p class="overview-card__title mb-0">Menus</p>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#overviewQuickItemModal">Quick add item</button>
        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#overviewQuickMenuModal">Add saved menu</button>
        <a href="/functions/<%= fn.id_uuid %>/quote" class="btn btn-sm btn-outline-primary">Open quote</a>
      </div>
    </div>
    <div class="menu-list">
      <% if (!menuSummary.length) { %>
        <div class="empty-state">No menus attached to this quote.</div>
      <% } else { %>
        <% menuSummary.forEach(function (menu) { %>
          <article class="menu-row" data-menu-id="<%= menu.id || '' %>" data-is-menu="<%= menu.is_menu ? 'true' : 'false' %>" data-menu-items='<%- JSON.stringify(menu.items || []) %>'>
            <div class="menu-row__body">
              <div>
                <p class="menu-row__title mb-0"><%= menu.name || ('Menu ' + menu.id) %></p>
                <p class="menu-row__meta text-muted small mb-0">
                  <%= menu.category || 'Catering' %>
                  <% if (menu.qty) { %> &bull; <%= menu.qty %> <%= menu.unit || 'each' %><% } %>
                </p>
              </div>
              <div class="text-end">
                <div class="fw-semibold">$<%= Number(menu.total_price || 0).toFixed(2) %></div>
                <small class="text-muted">Cost $<%= Number(menu.total_cost || 0).toFixed(2) %></small>
              </div>
            </div>
            <div class="menu-row__actions">
              <button class="btn btn-sm btn-outline-secondary" data-action="view-menu" data-menu-id="<%= menu.id || '' %>">View items</button>
              <% if (menu.is_menu && menu.id) { %>
                <button class="btn btn-sm btn-outline-primary" data-action="edit-menu" data-menu-id="<%= menu.id %>">Edit in quote</button>
              <% } else { %>
                <a href="/functions/<%= fn.id_uuid %>/quote" class="btn btn-sm btn-outline-primary">Open quote</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </section>

  <!-- ── 5. FINANCIAL SUMMARY ── -->
  <section class="overview-card overview-financial mb-3">
    <div class="overview-card__header">
      <div>
        <p class="overview-card__title mb-0">Financial summary</p>
        <% if (proposalAudit) { %>
          <span class="text-muted small">Proposal: <span class="badge bg-light text-dark text-uppercase"><%= proposalAudit.status %></span></span>
        <% } %>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary <%= proposalId ? '' : 'disabled' %>" data-bs-toggle="modal" data-bs-target="#quickPaymentModal" <%= proposalId ? '' : 'disabled' %>>Record payment</button>
        <a href="/functions/<%= fn.id_uuid %>/quote#totals" class="btn btn-sm btn-outline-secondary">Adjust in quote</a>
        <% if (proposalPreview) { %>
          <a href="<%= proposalPreview %>" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">View proposal</a>
        <% } %>
      </div>
    </div>
    <div class="financial-grid">
      <div class="financial-item">
        <span>Subtotal</span>
        <strong>$<%= Number(financialTotals.subtotal || 0).toFixed(2) %></strong>
      </div>
      <% if (Number(financialTotals.gratuity_amount || 0) > 0) { %>
        <div class="financial-item">
          <span>Gratuity (<%= Number(financialTotals.gratuity_percent || 0).toFixed(2) %>%)</span>
          <strong>$<%= Number(financialTotals.gratuity_amount || 0).toFixed(2) %></strong>
        </div>
      <% } %>
      <% if (Number(financialTotals.discount_amount || 0) > 0) { %>
        <div class="financial-item">
          <span>Discounts</span>
          <strong>$<%= Number(financialTotals.discount_amount || 0).toFixed(2) %></strong>
        </div>
      <% } %>
      <div class="financial-item">
        <span>Deposit</span>
        <strong>$<%= Number(financialTotals.deposit_amount || 0).toFixed(2) %></strong>
      </div>
      <div class="financial-item">
        <span>Total paid</span>
        <strong>$<%= Number(financialTotals.total_paid || 0).toFixed(2) %></strong>
      </div>
      <div class="financial-item financial-item--total">
        <span>Remaining due</span>
        <strong class="<%= Number(financialTotals.remaining_due || 0) > 0 ? 'text-danger' : 'text-success' %>">
          $<%= Number(financialTotals.remaining_due || 0).toFixed(2) %>
        </strong>
      </div>
    </div>
  </section>

  <!-- ── 6. FEEDBACK ── -->
  <section class="overview-card overview-feedback mb-3">
    <div class="overview-card__header">
      <p class="overview-card__title mb-0">Feedback</p>
      <a href="/settings/feedback" class="btn btn-sm btn-outline-secondary">View surveys</a>
    </div>
    <div class="feedback-feed">
      <% const feedbackList = Array.isArray(feedbackEntries) ? feedbackEntries : []; %>
      <% if (!feedbackList.length) { %>
        <div class="empty-state">No feedback received yet.</div>
      <% } else { %>
        <% feedbackList.forEach(function(entry) { %>
          <article class="feedback-entry">
            <div class="feedback-entry__icon">
              <i class="bi bi-emoji-smile"></i>
            </div>
            <div class="feedback-entry__body">
              <p class="mb-1 fw-semibold">
                Overall <%= entry.rating_overall || '—' %> / Service <%= entry.rating_service || '—' %>
                <% if (entry.nps_score || entry.nps_score === 0) { %>
                  <span class="badge bg-light text-dark ms-2">NPS <%= entry.nps_score %></span>
                <% } %>
                <% if (typeof entry.recommend !== 'undefined' && entry.recommend !== null) { %>
                  <span class="badge bg-light text-dark ms-2"><%= entry.recommend ? 'Would recommend' : 'Would not recommend' %></span>
                <% } %>
              </p>
              <% if (entry.comments) { %>
                <small class="text-muted d-block text-break"><%= entry.comments %></small>
              <% } else { %>
                <small class="text-muted d-block">No comments left.</small>
              <% } %>
            </div>
            <div class="feedback-entry__meta text-end">
              <span class="d-block"><%= entry.completed_at ? nzDate(entry.completed_at) : (entry.sent_at ? 'Sent ' + nzDate(entry.sent_at) : '-') %></span>
              <% if (entry.completed_at) { %>
                <small class="text-muted d-block"><%= nzTime(entry.completed_at) %></small>
              <% } %>
              <span class="badge bg-<%= entry.status === 'completed' ? 'success' : 'secondary' %> text-uppercase mt-2"><%= entry.status || 'pending' %></span>
            </div>
          </article>
        <% }); %>
      <% } %>
    </div>
  </section>

  <!-- ── 7. COMMUNICATIONS ── -->
  <section class="overview-card overview-communications mb-3">
    <div class="overview-card__header">
      <p class="overview-card__title mb-0">Recent communications</p>
      <a href="/functions/<%= fn.id_uuid %>/communications" class="btn btn-sm btn-outline-secondary">View all</a>
    </div>
    <div class="comms-feed">
      <% if (!communicationsFeed.length) { %>
        <div class="empty-state">No communications recorded.</div>
      <% } else { %>
        <% communicationsFeed.slice(0, 6).forEach(function (entry) { %>
          <article class="comms-entry">
            <div class="comms-entry__icon">
              <i class="bi <%= entry.type === 'proposal' ? 'bi-file-earmark-text' : entry.type === 'email' ? 'bi-envelope' : entry.type === 'survey' ? 'bi-clipboard-check' : 'bi-chat-left' %>"></i>
            </div>
            <div class="comms-entry__body">
              <p class="mb-1 fw-semibold text-truncate"><%= entry.subject || entry.title || entry.type || 'Update' %></p>
              <% if (entry.sender) { %>
                <small class="text-muted d-block text-break"><%= entry.sender %></small>
              <% } %>
              <small class="text-muted d-block text-truncate"><%= entry.preview || entry.summary || entry.note || '' %></small>
            </div>
            <div class="comms-entry__meta text-end">
              <span class="d-block"><%= nzDate(entry.entry_date || entry.created_at) %></span>
              <small class="text-muted"><%= nzTime(entry.entry_date || entry.created_at) %></small>
              <a href="<%= entry.link || '#' %>" class="btn btn-link btn-sm p-0 mt-2">Open</a>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
</section>
</div>

<!-- Run Sheet Modal -->

<!-- Menu Items Modal -->
<div class="modal fade" id="menuItemsModal" tabindex="-1" aria-labelledby="menuItemsModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="menuItemsModalTitle">Menu items</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="menuItemsModalBody">
        <p class="text-muted mb-0">No items recorded for this menu.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="runSheetModal" tabindex="-1" aria-labelledby="runSheetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <form id="runSheetForm">
        <div class="modal-header">
          <h5 class="modal-title" id="runSheetModalLabel">Build Run Sheet</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label text-muted small">Event date</label>
              <p class="fw-semibold mb-0"><%= nzDateRange(fn.event_date, fn.end_date) %></p>
            </div>
            <div class="col-sm-6">
              <label class="form-label text-muted small">Room / Guests</label>
              <p class="fw-semibold mb-0"><%= fn.room_name || 'Unassigned' %> · <%= fn.attendees || 0 %> guests</p>
            </div>
            <div class="col-sm-6">
              <label class="form-label text-muted small">Start time</label>
              <p class="fw-semibold mb-0"><%= nzTime(fn.start_time) %></p>
            </div>
            <div class="col-sm-6">
              <label class="form-label text-muted small">End time</label>
              <p class="fw-semibold mb-0"><%= nzTime(fn.end_time) %></p>
            </div>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Include notes</label>
            <% if (!allNotes.length) { %>
              <p class="text-muted mb-0">No notes available.</p>
            <% } else { %>
              <div class="run-sheet-checklist">
                <% allNotes.forEach(function(note) { %>
                  <label class="form-check form-check-inline run-sheet-option">
                    <input class="form-check-input" type="checkbox" name="notes" value="<%= note.id %>" checked>
                    <span class="form-check-label">
                      <% if (note.note_type === 'call') { %>Call<% } else if (note.note_type) { %><%= note.note_type.charAt(0).toUpperCase() + note.note_type.slice(1) %><% } else { %>Note<% } %>
                      <small class="text-muted ms-1"><%= new Date(note.updated_at || note.created_at || Date.now()).toLocaleDateString('en-NZ') %></small>
                    </span>
                  </label>
                <% }) %>
              </div>
            <% } %>
          </div>
          <div>
            <label class="form-label fw-semibold">Include menus</label>
            <% if (!menuSummary.length) { %>
              <p class="text-muted mb-0">No menus currently on the quote.</p>
            <% } else { %>
              <div class="run-sheet-checklist">
                <% menuSummary.forEach(function(menu) { %>
                  <label class="form-check run-sheet-option">
                    <input class="form-check-input" type="checkbox" name="menus" value="<%= menu.id %>" checked>
                    <span class="form-check-label">
                      <strong><%= menu.name %></strong>
                      <small class="text-muted ms-1"><%= menu.category || 'Catering' %></small>
                    </span>
                  </label>
                <% }) %>
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="runSheetIncludeCosts" name="include_costs" value="true">
                <label class="form-check-label small" for="runSheetIncludeCosts">Show costs on run sheet</label>
              </div>
            <% } %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="runSheetPreviewBtn">Preview</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Quick Note Modal -->
