<!-- Quick Payment Modal -->
<div class="modal fade" id="quickPaymentModal" tabindex="-1" aria-labelledby="quickPaymentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="quickPaymentForm">
        <div class="modal-header">
          <h5 class="modal-title" id="quickPaymentModalLabel">Record payment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Recent payments</label>
            <% const recentPayments = Array.isArray(paymentHistory) ? paymentHistory.slice(0, 5) : []; %>
            <% if (!recentPayments.length) { %>
              <div class="text-muted small border rounded p-2">No payments recorded yet.</div>
            <% } else { %>
              <div class="border rounded p-2">
                <% recentPayments.forEach((payment) => { %>
                  <div class="d-flex justify-content-between align-items-start small <%= payment === recentPayments[recentPayments.length - 1] ? '' : 'mb-2 border-bottom pb-2' %>">
                    <div>
                      <div class="fw-semibold"><%= payment.payment_type || 'Payment' %></div>
                      <div class="text-muted"><%= payment.paid_on ? new Date(payment.paid_on).toLocaleDateString('en-NZ') : '-' %> · <%= payment.method || 'other' %></div>
                    </div>
                    <div class="fw-semibold">$<%= Number(payment.amount || 0).toFixed(2) %></div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label">Payment description</label>
            <input type="text" name="payment_type" class="form-control" placeholder="e.g. Deposit" required>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">Date paid</label>
              <input type="date" name="paid_on" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required>
            </div>
            <div class="col-6">
              <label class="form-label">Amount ($)</label>
              <input type="number" step="0.01" min="0" name="amount" class="form-control" required>
            </div>
          </div>
          <div class="mt-3">
            <label class="form-label">Payment method</label>
            <select name="method" class="form-select">
              <option value="online">Online</option>
              <option value="till">Till</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save payment</button>
        </div>
      </form>
    </div>
  </div>
</div>

