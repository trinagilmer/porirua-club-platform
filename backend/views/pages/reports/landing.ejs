</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function() {
    const chartData = <%- JSON.stringify(chartData || {}) %>;
    const canvas = document.getElementById('reportsOverviewTrend');
    const pdfButton = document.getElementById('reportsOverviewPdfBtn');
    const printImage = document.getElementById('reportsOverviewTrendPrintImage');
    const printSummaryImage = document.getElementById('reportsOverviewPrintSummaryChart');
    if (pdfButton) {
      pdfButton.addEventListener('click', function() {
        if (canvas && printImage) syncPrintChartImage();
        window.print();
      });
    }
    if (!canvas || !chartData.labels || !chartData.labels.length) return;
    const ctx = canvas.getContext('2d');
    const overviewChart = new Chart(ctx, {
      data: {
        labels: chartData.labels,
        datasets: [
          {
            type: 'bar',
            label: 'Functions',
            data: chartData.functions,
            backgroundColor: 'rgba(107, 180, 222, 0.88)',
            borderColor: '#4a9ecc',
            borderWidth: 1,
            borderRadius: 8,
          },
          {
            type: 'bar',
            label: 'Restaurant',
            data: chartData.restaurant,
            backgroundColor: 'rgba(166, 214, 174, 0.88)',
            borderColor: '#7eb488',
            borderWidth: 1,
            borderRadius: 8,
          },
          {
            type: 'line',
            label: 'Entertainment',
            data: chartData.entertainment,
            borderColor: '#2f7d68',
            backgroundColor: 'rgba(47, 125, 104, 0.14)',
            pointBackgroundColor: '#2f7d68',
            pointBorderColor: '#ffffff',
            pointRadius: 4,
            tension: 0.35,
            fill: false,
            yAxisID: 'y',
          },
          {
            type: 'line',
            label: 'Function revenue',
            data: chartData.revenue,
            borderColor: '#c96f1a',
            backgroundColor: 'rgba(201, 111, 26, 0.14)',
            pointBackgroundColor: '#c96f1a',
            pointBorderColor: '#ffffff',
            pointRadius: 4,
            tension: 0.3,
            fill: false,
            yAxisID: 'y1',
          }
        ]
      },
      options: {
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        scales: {
          y: {
            beginAtZero: true,
            title: { display: true, text: 'Activity count' }
          },
          y1: {
            beginAtZero: true,
            position: 'right',
            grid: { drawOnChartArea: false },
            title: { display: true, text: 'Revenue (NZD)' }
          }
        }
      }
    });

    function syncPrintChartImage() {
      if (!canvas) return;
      try {
        const chartDataUrl = canvas.toDataURL('image/png');
        if (printImage) printImage.src = chartDataUrl;
        if (printSummaryImage) printSummaryImage.src = chartDataUrl;
      } catch (error) {
        if (printImage) printImage.removeAttribute('src');
        if (printSummaryImage) printSummaryImage.removeAttribute('src');
      }
    }

    syncPrintChartImage();
    window.addEventListener('beforeprint', syncPrintChartImage);
    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('print');
      if (mediaQuery && mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', function(event) {
          if (event.matches) syncPrintChartImage();
        });
      }
    }
    if (overviewChart) {
      setTimeout(syncPrintChartImage, 150);
    }
  })();
</script>
