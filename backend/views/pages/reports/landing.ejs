<%
  const groupedReports = reportGroups || {};
  const categoryEntries = Object.entries(groupedReports);
  const overviewCards = (overview && overview.cards) || [];
  const overviewHighlights = (overview && overview.highlights) || [];
  const highlightGroups = overviewHighlights.reduce(function(acc, item) {
    const group = item.group || "Overview";
    if (!acc[group]) acc[group] = [];
    acc[group].push(item);
    return acc;
  }, {});
  const highlightGroupEntries = Object.entries(highlightGroups);
  const breakdowns = (overview && overview.breakdowns) || {};
  const chartData = (overview && overview.chartData) || { labels: [], functions: [], restaurant: [], entertainment: [], revenue: [] };
  function buildLink(type) {
    const params = new URLSearchParams({
      type,
      start_date: filters.startDate || "",
      end_date: filters.endDate || "",
    });
    return `/reports?${params.toString()}`;
  }
  function formatBreakdownLabel(value) {
    return String(value || "-")
      .replace(/_/g, " ")
      .replace(/\b\w/g, function(letter) { return letter.toUpperCase(); });
  }
%>

<div class="container-fluid py-4 reports-page">
  <section class="reports-print-header print-only">
    <div class="reports-print-header__eyebrow">Porirua Club</div>
    <h1 class="reports-print-header__title">Reports Overview</h1>
    <p class="reports-print-header__range mb-0"><%= filters.startDate %> to <%= filters.endDate %></p>
  </section>
  <section class="reports-print-summary print-only">
    <div class="reports-print-stats">
      <% overviewCards.forEach(function(card) { %>
        <article class="reports-print-stat">
          <div class="reports-print-stat__label"><%= card.label %></div>
          <div class="reports-print-stat__value"><%= card.value %></div>
          <div class="reports-print-stat__detail"><%= card.detail %></div>
        </article>
      <% }) %>
    </div>
    <div class="reports-print-takeaways">
      <div class="reports-print-takeaways__label">Quick takeaways</div>
      <div class="reports-print-takeaway-groups">
        <% highlightGroupEntries.forEach(function(groupEntry) { %>
          <section class="reports-print-takeaway-group">
            <div class="reports-print-takeaway-group__title"><%= groupEntry[0] %></div>
            <div class="reports-print-takeaways__grid">
              <% groupEntry[1].forEach(function(item) { %>
                <article class="reports-print-takeaway">
                  <div class="reports-print-takeaway__title"><%= item.title %></div>
                  <div class="reports-print-takeaway__value"><%= formatBreakdownLabel(item.value) %></div>
                </article>
              <% }) %>
            </div>
          </section>
        <% }) %>
      </div>
    </div>
    <div class="reports-print-chart-card">
      <div class="reports-print-chart-card__head">
        <div>
          <div class="reports-print-chart-card__label">Activity trend</div>
          <h2 class="reports-print-chart-card__title">Daily volume across the platform</h2>
        </div>
        <p class="reports-print-chart-card__meta">Counts per day for functions, restaurant bookings, and entertainment events.</p>
      </div>
      <img id="reportsOverviewPrintSummaryChart" class="reports-print-summary-chart" alt="Reports overview activity trend chart" />
    </div>
  </section>
  <div class="row g-4 align-items-start">
    <aside class="col-12 col-xl-3 no-print">
      <div class="card shadow-sm border-0 reports-sidebar sticky-xl-top" style="top: 88px;">
        <div class="card-body p-3 p-lg-4">
          <div class="mb-4">
            <p class="text-uppercase text-muted small mb-2">Reports hub</p>
            <h1 class="h3 mb-2">Reports</h1>
            <p class="text-muted mb-0">Start from the overview, then jump straight into a detailed report from the left.</p>
          </div>

          <div class="reports-range-pill mb-4">
            <div class="small text-uppercase text-muted mb-1">Current range</div>
            <strong><%= filters.startDate %></strong>
            <span class="text-muted">to</span>
            <strong><%= filters.endDate %></strong>
          </div>

          <% categoryEntries.forEach(function(entry) { %>
            <% const group = entry[0]; const items = entry[1]; %>
            <div class="mb-4">
              <div class="reports-nav-label"><%= group %></div>
              <nav class="nav flex-column gap-2">
                <% items.forEach(function(item) { %>
                  <a class="reports-nav-link" href="<%= buildLink(item.value) %>">
                    <span><%= item.label %></span>
                    <i class="bi bi-arrow-up-right-circle"></i>
                  </a>
                <% }) %>
              </nav>
            </div>
          <% }) %>

          <div class="d-grid gap-2">
            <a class="btn btn-outline-primary" href="/calendar">
              <i class="bi bi-calendar3 me-1"></i>
              Back to calendar
            </a>
            <a class="btn btn-outline-secondary" href="/settings">
              <i class="bi bi-gear me-1"></i>
              Settings
            </a>
          </div>
        </div>
      </div>
    </aside>

    <main class="col-12 col-xl-9">
      <section class="card shadow-sm border-0 mb-4 reports-hero-card">
        <div class="card-body p-4 p-xl-5">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
              <p class="text-uppercase text-muted small mb-2">Overview dashboard</p>
              <h2 class="mb-2">Your key reporting signals in one view</h2>
              <p class="text-muted mb-0">This page gives you the headline movement across functions, restaurant, and entertainment before you drill into a single report.</p>
            </div>
            <div class="reports-hero-accent">
              <span>Live overview</span>
            </div>
          </div>

          <form class="row g-3 align-items-end" method="GET" action="/reports">
            <div class="col-md-4 col-sm-6">
              <label class="form-label">Overview start date</label>
              <input type="date" name="start_date" class="form-control" value="<%= filters.startDate %>">
            </div>
            <div class="col-md-4 col-sm-6">
              <label class="form-label">Overview end date</label>
              <input type="date" name="end_date" class="form-control" value="<%= filters.endDate %>">
            </div>
            <div class="col-md-4 col-sm-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">Refresh overview</button>
              <button type="button" class="btn btn-outline-secondary no-print" id="reportsOverviewPdfBtn">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                Export PDF
              </button>
            </div>
          </form>
          <p class="text-muted small mt-3 mb-0 no-print">Export PDF opens the browser print flow with this overview formatted for Save as PDF.</p>
        </div>
      </section>

      <section class="row g-3 mb-4 reports-kpi-section">
        <% overviewCards.forEach(function(card) { %>
          <div class="col-sm-6 col-xxl-3">
            <div class="card shadow-sm border-0 h-100 report-kpi-card">
              <div class="card-body">
                <p class="text-uppercase text-muted small mb-2"><%= card.label %></p>
                <h3 class="display-6 mb-2"><%= card.value %></h3>
                <p class="mb-0 text-muted small"><%= card.detail %></p>
              </div>
            </div>
          </div>
        <% }) %>
      </section>

      <section class="row g-4 mb-4 reports-chart-section">
        <div class="col-12 col-xxl-8">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <div>
                  <p class="text-uppercase text-muted small mb-1">Activity trend</p>
                  <h3 class="h5 mb-0">Daily volume across the platform</h3>
                </div>
                <p class="text-muted small mb-0">Counts per day for functions, restaurant bookings, and entertainment events.</p>
              </div>
              <div style="height: 320px;">
                <canvas id="reportsOverviewTrend"></canvas>
                <img id="reportsOverviewTrendPrintImage" class="reports-print-chart" alt="Reports overview activity trend chart" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-xxl-4">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
              <p class="text-uppercase text-muted small mb-1">Highlights</p>
              <h3 class="h5 mb-3">Quick takeaways</h3>
              <div class="d-flex flex-column gap-3">
                <% highlightGroupEntries.forEach(function(groupEntry) { %>
                  <section class="reports-highlight-group">
                    <div class="reports-highlight-group__title"><%= groupEntry[0] %></div>
                    <div class="d-flex flex-column gap-3">
                      <% groupEntry[1].forEach(function(item) { %>
                        <div class="reports-highlight-item">
                          <div class="small text-muted text-uppercase"><%= item.title %></div>
                          <div class="fw-semibold"><%= formatBreakdownLabel(item.value) %></div>
                          <div class="small text-muted"><%= item.meta %></div>
                        </div>
                      <% }) %>
                    </div>
                  </section>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <p class="text-uppercase text-muted small mb-1">Function status mix</p>
              <h3 class="h5 mb-3">Pipeline snapshot</h3>
              <div class="d-flex flex-column gap-2">
                <% Object.entries(breakdowns.functions || {}).forEach(function(entry) { %>
                  <div class="reports-breakdown-row">
                    <span><%= formatBreakdownLabel(entry[0]) %></span>
                    <strong><%= entry[1] %></strong>
                  </div>
                <% }) %>
                <% if (!Object.keys(breakdowns.functions || {}).length) { %>
                  <p class="text-muted small mb-0">No function activity in the selected range.</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="row g-4 mb-4 reports-secondary-section">
        <div class="col-12 col-lg-6">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
              <p class="text-uppercase text-muted small mb-1">Restaurant status mix</p>
              <h3 class="h5 mb-3">Booking flow</h3>
              <div class="d-flex flex-wrap gap-2">
                <% Object.entries(breakdowns.restaurant || {}).forEach(function(entry) { %>
                  <span class="badge rounded-pill text-bg-light reports-pill"><%= formatBreakdownLabel(entry[0]) %>: <%= entry[1] %></span>
                <% }) %>
                <% if (!Object.keys(breakdowns.restaurant || {}).length) { %>
                  <span class="text-muted small">No restaurant activity in the selected range.</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
              <p class="text-uppercase text-muted small mb-1">Entertainment status mix</p>
              <h3 class="h5 mb-3">Events snapshot</h3>
              <div class="d-flex flex-wrap gap-2">
                <% Object.entries(breakdowns.entertainment || {}).forEach(function(entry) { %>
                  <span class="badge rounded-pill text-bg-light reports-pill"><%= formatBreakdownLabel(entry[0]) %>: <%= entry[1] %></span>
                <% }) %>
                <% if (!Object.keys(breakdowns.entertainment || {}).length) { %>
                  <span class="text-muted small">No entertainment activity in the selected range.</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="card shadow-sm border-0 reports-launch-section">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <p class="text-uppercase text-muted small mb-1">Quick launch</p>
              <h3 class="h5 mb-0">Popular detailed reports</h3>
            </div>
          </div>
          <div class="row g-3">
            <% (reportCards || []).slice(0, 6).forEach(function(card) { %>
              <div class="col-md-6 col-xxl-4">
                <a class="card h-100 shadow-sm border-0 text-decoration-none reports-launch-card" href="<%= buildLink(card.type) %>">
                  <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <div class="reports-launch-icon"><i class="bi <%= card.icon %>"></i></div>
                      <h4 class="h6 mb-0 text-dark"><%= card.title %></h4>
                    </div>
                    <p class="text-muted small mb-0"><%= card.description %></p>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

