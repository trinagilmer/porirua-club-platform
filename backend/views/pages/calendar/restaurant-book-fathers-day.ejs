<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Porirua Club</title>
    <style>
      :root {
        --ink: #241d17;
        --muted: #6d6257;
        --paper: #fbf5e9;
        --green: #122c35;
        --green-dark: #081b22;
        --gold: #b77918;
        --line: #d5c7b2;
        --error: #9f2828;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          linear-gradient(rgba(251,245,233,.88), rgba(251,245,233,.88)),
          repeating-linear-gradient(90deg, #cdbb9f 0, #cdbb9f 2px, #e7dcc9 2px, #e7dcc9 28px);
        font-family: Georgia, "Times New Roman", serif;
      }
      .page { width: min(100%, 760px); margin: 0 auto; padding: 24px 16px 48px; }
      .masthead {
        overflow: hidden;
        background: #061820;
        border-bottom: 4px solid var(--gold);
      }
      .masthead img { display: block; width: 100%; height: auto; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
      .eyebrow {
        margin: 0 0 10px;
        color: var(--green);
        font-family: "Trebuchet MS", sans-serif;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
      }
      .form-panel { background: #fff; padding: clamp(20px, 6vw, 48px); }
      .notice { margin: 0 0 24px; padding: 14px 16px; border-left: 4px solid var(--green); background: #eef3f3; }
      .notice.error { border-color: var(--error); background: #fff0f0; color: var(--error); }
      .section-title { margin: 0 0 14px; font-size: 1.18rem; }
      .service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .service-option { position: relative; }
      .service-option input { position: absolute; opacity: 0; pointer-events: none; }
      .service-option label {
        display: block;
        min-height: 62px;
        padding: 17px;
        border: 2px solid var(--line);
        background: var(--paper);
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease;
      }
      .service-option input:checked + label { border-color: var(--gold); background: #f5ead7; box-shadow: inset 0 0 0 1px var(--gold); }
      .service-option input:focus-visible + label { outline: 3px solid rgba(217,166,46,.55); outline-offset: 2px; }
      .service-name { display: block; font-size: 1.1rem; font-weight: 700; }
      .service-window { display: block; margin-top: 5px; color: var(--muted); font-family: "Trebuchet MS", sans-serif; font-size: .86rem; }
      .field { margin-top: 20px; }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      label.field-label { display: block; margin-bottom: 7px; font-family: "Trebuchet MS", sans-serif; font-size: .9rem; font-weight: 700; }
      input, select, textarea {
        width: 100%;
        border: 1px solid #aeb8af;
        border-radius: 4px;
        background: #fff;
        color: var(--ink);
        padding: 12px;
        font: 1rem "Trebuchet MS", sans-serif;
      }
      input:focus, select:focus, textarea:focus { outline: 3px solid rgba(217,166,46,.38); border-color: var(--green); }
      textarea { resize: vertical; }
      .hint { display: block; min-height: 18px; margin-top: 5px; color: var(--muted); font: .8rem "Trebuchet MS", sans-serif; }
      button {
        width: 100%;
        margin-top: 28px;
        border: 0;
        border-radius: 4px;
        background: var(--green);
        color: #fff;
        padding: 15px 20px;
        font: 700 1rem "Trebuchet MS", sans-serif;
        cursor: pointer;
      }
      button:hover { background: var(--green-dark); }
      button:disabled { background: #869188; cursor: not-allowed; }
      .empty { padding: 18px; border: 1px solid var(--line); background: var(--paper); color: var(--muted); }
      @media (max-width: 560px) {
        .page { padding: 0; }
        .field-row { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <% const values = formData || {}; %>
    <% const serviceList = Array.isArray(services) ? services : []; %>
    <% const toMinutes = function(time) { const parts = String(time).slice(0, 5).split(':').map(Number); return parts[0] * 60 + parts[1]; }; %>
    <% const valueTime = function(minutes) { return String(Math.floor(minutes / 60)).padStart(2, '0') + ':' + String(minutes % 60).padStart(2, '0'); }; %>
    <% const labelTime = function(minutes) { const hour = Math.floor(minutes / 60); return (hour % 12 || 12) + ':' + String(minutes % 60).padStart(2, '0') + (hour >= 12 ? ' pm' : ' am'); }; %>
    <% const requestedTimes = (bookingTimes || []).map(toMinutes); %>
    <% const bookingSlots = requestedTimes.map(function(minutes) { const exactService = serviceList.find(function(service) { return toMinutes(service.start_time) === minutes; }); const service = exactService || serviceList.find(function(item) { return minutes >= toMinutes(item.start_time) && minutes <= toMinutes(item.end_time); }); return service ? { service: service, minutes: minutes, value: String(service.id) + '|' + valueTime(minutes) } : null; }).filter(Boolean); %>
    <% const lunchSlots = bookingSlots.filter(function(slot) { return slot.minutes < 15 * 60; }); %>
    <% const dinnerSlots = bookingSlots.filter(function(slot) { return slot.minutes >= 15 * 60; }); %>
    <main class="page">
      <header class="masthead">
        <h1 class="visually-hidden">Eastwood Restaurant at Porirua Club Father's Day Buffet</h1>
        <img src="/img/form%20banner.png" alt="Eastwood Restaurant Father's Day Buffet, Sunday 6 September 2026">
      </header>

      <section class="form-panel">
        <% if (success) { %>
          <div class="notice" role="status">
            Thank you. Your Father's Day booking request has been received. We will confirm it with you shortly.
          </div>
        <% } %>
        <% if (errorMessage) { %>
          <div class="notice error" role="alert"><%= errorMessage %></div>
        <% } %>

        <form method="POST" action="/calendar/restaurant/book/fathers-day" id="fathersDayForm">
          <input type="hidden" name="booking_date" value="<%= bookingDate %>">

          <h2 class="section-title">Choose a time</h2>
          <% if (bookingSlots.length) { %>
            <% [{ label: 'Lunch', slots: lunchSlots }, { label: 'Dinner', slots: dinnerSlots }].forEach(function(group) { %>
              <% if (group.slots.length) { %>
                <h3 class="eyebrow"><%= group.label %></h3>
                <div class="service-grid">
                  <% group.slots.forEach(function(slot, index) { %>
                    <% const isFirstSlot = slot.value === bookingSlots[0].value; %>
                    <% const selected = String(values.booking_slot || '') === slot.value || (!values.booking_slot && isFirstSlot); %>
                    <div class="service-option">
                      <input
                        type="radio"
                        name="booking_slot"
                        id="slot-<%= slot.service.id %>-<%= slot.minutes %>"
                        value="<%= slot.value %>"
                        data-max-party="<%= slot.service.max_online_party_size || '' %>"
                        <%= selected ? 'checked' : '' %>
                        required
                      >
                      <label for="slot-<%= slot.service.id %>-<%= slot.minutes %>">
                        <span class="service-name"><%= labelTime(slot.minutes) %></span>
                      </label>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            <% }) %>

            <div class="field-row">
              <div class="field">
                <label class="field-label" for="partyName">Name</label>
                <input id="partyName" name="party_name" autocomplete="name" value="<%= values.party_name || '' %>" required>
              </div>
              <div class="field">
                <label class="field-label" for="partySize">Number of guests</label>
                <input id="partySize" name="size" type="number" min="1" inputmode="numeric" value="<%= values.size || '' %>" required>
                <small class="hint" id="guestHint"></small>
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label class="field-label" for="email">Email</label>
                <input id="email" name="contact_email" type="email" autocomplete="email" value="<%= values.contact_email || '' %>" required>
              </div>
              <div class="field">
                <label class="field-label" for="phone">Phone</label>
                <input id="phone" name="contact_phone" type="tel" autocomplete="tel" value="<%= values.contact_phone || '' %>" required>
              </div>
            </div>

            <div class="field">
              <label class="field-label" for="notes">Dietary requirements or notes</label>
              <textarea id="notes" name="notes" rows="3"><%= values.notes || '' %></textarea>
            </div>

            <button type="submit">Request Father's Day booking</button>
          <% } else { %>
            <div class="empty">Father's Day service times are not available yet. Please check again soon.</div>
          <% } %>
        </form>
      </section>
    </main>

    <script>
      (function () {
        const partySize = document.getElementById("partySize");
        const guestHint = document.getElementById("guestHint");
        const slotInputs = Array.from(document.querySelectorAll('input[name="booking_slot"]'));
        if (!slotInputs.length) return;

        const updateService = () => {
          const slot = slotInputs.find((input) => input.checked);
          if (!slot) return;
          const maxParty = Number(slot.dataset.maxParty);
          if (maxParty > 0) {
            partySize.max = String(maxParty);
            guestHint.textContent = `Online bookings are available for up to ${maxParty} guests.`;
          } else {
            partySize.removeAttribute("max");
            guestHint.textContent = "";
          }
        };

        slotInputs.forEach((input) => input.addEventListener("change", updateService));
        updateService();
      })();
    </script>
  </body>
</html>