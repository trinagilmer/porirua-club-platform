<main class="settings-teamup">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Teamup Integration</h1>
      <p class="text-muted mb-0">Connect your assistant manager's Teamup calendar so events appear in the Function Calendar.</p>
    </div>
    <a href="/calendar" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">
      Open Calendar
    </a>
  </div>

  <% if (success) { %>
    <div class="alert alert-success">Teamup settings saved successfully.</div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger"><%= errorMessage %></div>
  <% } %>

  <div class="card shadow-sm p-4 mb-4" style="max-width: 640px;">
    <h5 class="mb-1">API Credentials</h5>
    <p class="text-muted small mb-3">
      You need two separate values from Teamup:
    </p>
    <ul class="small text-muted mb-3">
      <li>
        <strong>Calendar Key</strong> — the unique ID in your Teamup calendar URL.
        Open the calendar, look at the address bar:
        <code>teamup.com/<strong>ks8abcXYZ123</strong></code> — copy the part after the slash.
      </li>
      <li class="mt-1">
        <strong>API Token</strong> — an <em>account-level</em> API key, <strong>not</strong> a calendar sharing password.
        Go to <a href="https://teamup.com/account/api-keys" target="_blank" rel="noopener">teamup.com → Account Settings → API Keys</a>,
        click <strong>Create API Key</strong>, then copy the generated key.
        It is a long string of letters and numbers.
      </li>
    </ul>
    <form action="/settings/teamup" method="POST">
      <div class="mb-3">
        <label for="calendarKey" class="form-label fw-semibold">
          Calendar Key <span class="text-danger">*</span>
        </label>
        <input
          type="text"
          id="calendarKey"
          name="calendar_key"
          class="form-control"
          value="<%= settings.calendar_key || '' %>"
          placeholder="e.g. ks8abcXYZ123"
          required
          autocomplete="off"
        >
        <small class="text-muted">The unique key in your Teamup calendar URL.</small>
      </div>

      <div class="mb-3">
        <label for="apiToken" class="form-label fw-semibold">API Token</label>
        <input
          type="password"
          id="apiToken"
          name="api_token"
          class="form-control"
          value=""
          placeholder="<%= tokenConfigured ? '●●●●●●●● (saved — leave blank to keep current)' : 'Paste your Teamup API token' %>"
          autocomplete="new-password"
        >
        <% if (tokenConfigured) { %>
          <small class="text-success"><i class="bi bi-check-circle me-1"></i>Token is configured. Leave blank to keep the existing value.</small>
        <% } else { %>
          <small class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>No API token saved yet. Syncing will be unavailable until this is set.</small>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="authToken" class="form-label fw-semibold">Bearer Auth Token <span class="text-muted fw-normal">(optional)</span></label>
        <input
          type="password"
          id="authToken"
          name="auth_token"
          class="form-control"
          value=""
          placeholder="<%= authTokenConfigured ? '●●●●●●●● (saved — leave blank to keep current)' : 'Paste bearer token if this calendar key requires login' %>"
          autocomplete="new-password"
        >
        <% if (authTokenConfigured) { %>
          <small class="text-success"><i class="bi bi-check-circle me-1"></i>Bearer auth token is configured. Leave blank to keep the existing value.</small>
        <% } else { %>
          <small class="text-muted">Only needed if Teamup returns <strong>login required</strong> for this calendar key. Use the <code>auth_token</code> returned by Teamup's authentication endpoint.</small>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="subcalendarIds" class="form-label fw-semibold">Subcalendar IDs <span class="text-muted fw-normal">(optional)</span></label>
        <input
          type="text"
          id="subcalendarIds"
          name="subcalendar_ids"
          class="form-control"
          value="<%= settings.subcalendar_ids || '' %>"
          placeholder="e.g. 123456,789012"
          autocomplete="off"
        >
        <small class="text-muted">Comma-separated subcalendar IDs to filter. Leave blank to import all subcalendars.</small>
      </div>

      <div class="d-flex gap-2 align-items-center">
        <button type="submit" class="btn btn-primary">Save credentials</button>
        <a href="/settings/overview" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>

  <div class="card shadow-sm p-4" style="max-width: 640px;">
    <h5 class="mb-1">Connection</h5>
    <p class="text-muted small mb-3">Test that your credentials are valid and the Teamup API is reachable.</p>
    <div class="d-flex gap-2 align-items-start flex-wrap">
      <button type="button" class="btn btn-outline-primary" id="teamupTestBtn">Test connection</button>
      <button type="button" class="btn btn-primary" id="teamupSyncBtn">Sync events now</button>
      <button type="button" class="btn btn-outline-secondary" id="teamupSubcalendarsBtn">List subcalendars</button>
    </div>
    <p class="small mt-2 mb-0" id="teamupTestStatus" aria-live="polite"></p>
    <div id="teamupSubcalendarList" class="mt-3 d-none">
      <p class="text-muted text-uppercase small mb-2">Subcalendars found</p>
      <table class="table table-sm table-bordered mb-0">
        <thead><tr><th>ID</th><th>Name</th><th>Active</th></tr></thead>
        <tbody id="teamupSubcalendarBody"></tbody>
      </table>
      <p class="small text-muted mt-1 mb-0">Copy any IDs you want to filter by into the Subcalendar IDs field above. Leave blank to import all.</p>
    </div>
  </div>
</main>

<script>
(function () {
  const statusEl = document.getElementById("teamupTestStatus");
  const testBtn = document.getElementById("teamupTestBtn");
  const syncBtn = document.getElementById("teamupSyncBtn");

  function setStatus(msg, isError) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = "small mt-2 mb-0 " + (isError ? "text-danger" : "text-success");
  }

  if (testBtn) {
    testBtn.addEventListener("click", async function () {
      testBtn.disabled = true;
      setStatus("Testing connection...", false);
      try {
        const res = await fetch("/calendar/teamup/connection-test", { headers: { Accept: "application/json" } });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok || !payload.success) throw new Error(payload.error || "Connection test failed");
        const count = payload.eventsAfterSubcalendarFilter ?? payload.eventsFetched ?? 0;
        setStatus("Connected. Teamup API is reachable (" + count + " events in today's range).", false);
      } catch (err) {
        setStatus(err.message || "Unable to connect to Teamup", true);
      } finally {
        testBtn.disabled = false;
      }
    });
  }

  if (syncBtn) {
    syncBtn.addEventListener("click", async function () {
      syncBtn.disabled = true;
      setStatus("Syncing Teamup events...", false);
      try {
        const res = await fetch("/calendar/teamup/sync", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({}),
        });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok || !payload.success) throw new Error(payload.error || "Sync failed");
        setStatus("Sync complete. " + (payload.upserted || 0) + " events updated.", false);
      } catch (err) {
        setStatus(err.message || "Unable to sync Teamup events", true);
      } finally {
        syncBtn.disabled = false;
      }
    });
  }

  const subcalendarsBtn = document.getElementById("teamupSubcalendarsBtn");
  const subcalendarList = document.getElementById("teamupSubcalendarList");
  const subcalendarBody = document.getElementById("teamupSubcalendarBody");

  if (subcalendarsBtn) {
    subcalendarsBtn.addEventListener("click", async function () {
      subcalendarsBtn.disabled = true;
      setStatus("Loading subcalendars...", false);
      try {
        const res = await fetch("/calendar/teamup/subcalendars", { headers: { Accept: "application/json" } });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok || !payload.success) throw new Error(payload.error || "Unable to load subcalendars");
        const subs = payload.subcalendars || [];
        if (subcalendarBody) {
          subcalendarBody.innerHTML = subs.length
            ? subs.map(function (sub) {
                return "<tr><td><code>" + sub.id + "</code></td><td>" + (sub.name || "—") + "</td><td>" + (sub.active ? "Yes" : "No") + "</td></tr>";
              }).join("")
            : "<tr><td colspan='3' class='text-muted'>No subcalendars found.</td></tr>";
        }
        if (subcalendarList) subcalendarList.classList.remove("d-none");
        setStatus("Found " + subs.length + " subcalendar" + (subs.length === 1 ? "" : "s") + ".", false);
      } catch (err) {
        setStatus(err.message || "Unable to load subcalendars", true);
      } finally {
        subcalendarsBtn.disabled = false;
      }
    });
  }
})();
</script>
